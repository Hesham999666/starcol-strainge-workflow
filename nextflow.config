profiles {

    saga {

        params {
            input_dir1      = 'data/fastq'
            input_dir2      = 'data/hdf5'
            outdir          = 'results'

            db_dir          = 'database/'
            db_name         = 'DonorB'

            score           = 0.0000002
            iterations      = 50
            save_intermeds  = false
        }

        conda.enabled = true
        conda.autoActivate = true

        cleanup = true

        process {
            executor = 'slurm'
            maxForks = 19
            cpus   = 1
            memory = 4.GB
            time   = '12h'
            queue  = 'normal'
        }
    }
}
